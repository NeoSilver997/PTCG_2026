# PTCG Qwen-VL 环境配置

# =============================================================================
# 数据库配置
# =============================================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/ptcg_2026"

# =============================================================================
# Qwen-VL 推理服务配置
# =============================================================================

# 推理服务 URL
QWEN_VL_INFERENCE_URL=http://localhost:8000

# 推理服务脚本路径
QWEN_VL_SCRIPT_PATH=./scripts/qwen-vl-finetune/inference_service.py

# 置信度阈值（低于此值的结果会被标记）
QWEN_VL_CONFIDENCE_THRESHOLD=0.7

# 推理超时时间（毫秒）
QWEN_VL_TIMEOUT=30000

# 最大重试次数
QWEN_VL_MAX_RETRIES=2

# =============================================================================
# 模型配置
# =============================================================================

# 模型路径（微调后的模型）
QWEN_VL_MODEL_PATH=./scripts/qwen-vl-finetune/outputs/final

# 基础模型名称（用于重新训练）
QWEN_VL_BASE_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# 运行设备 (cuda/cpu)
QWEN_VL_DEVICE=cuda

# =============================================================================
# 训练配置
# =============================================================================

# LoRA rank
QWEN_VL_LORA_R=16

# LoRA alpha
QWEN_VL_LORA_ALPHA=32

# LoRA dropout
QWEN_VL_LORA_DROPOUT=0.05

# 学习率
QWEN_VL_LEARNING_RATE=2e-4

# 批大小
QWEN_VL_BATCH_SIZE=2

# 梯度累积步数
QWEN_VL_GRADIENT_ACCUMULATION_STEPS=8

# 训练轮数
QWEN_VL_EPOCHS=3

# 最大序列长度
QWEN_VL_MAX_SEQ_LENGTH=2048

# =============================================================================
# 日志配置
# =============================================================================

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=./logs/qwen-vl.log

# =============================================================================
# API 配置 (NestJS)
# =============================================================================

# API 端口
PORT=3000

# API 主机
HOST=0.0.0.0

# 启用 Swagger
SWAGGER_ENABLED=true

# =============================================================================
# 图像处理配置
# =============================================================================

# 最大图像大小（字节）
MAX_IMAGE_SIZE=10485760

# 支持的图像格式
SUPPORTED_IMAGE_FORMATS=jpeg,jpg,png,webp

# 图像预处理 - 调整大小
IMAGE_RESIZE=true

# 图像预处理 - 目标尺寸
IMAGE_TARGET_SIZE=1024

# =============================================================================
# 缓存配置
# =============================================================================

# 启用推理缓存
INFERENCE_CACHE_ENABLED=true

# 缓存 TTL（秒）
INFERENCE_CACHE_TTL=3600

# 最大缓存条目数
INFERENCE_CACHE_MAX_SIZE=1000

# =============================================================================
# 监控配置
# =============================================================================

# 启用 Prometheus 指标
METRICS_ENABLED=true

# Prometheus 端口
METRICS_PORT=9090

# 启用分布式追踪
TRACING_ENABLED=false

# Jaeger 端点
JAEGER_ENDPOINT=http://localhost:14268/api/traces
